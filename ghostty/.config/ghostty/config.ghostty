font-family = "IosevkaTerm Nerd Font Mono"
window-title-font-family = "IosevkaTerm Nerd Font Mono"

cursor-style-blink = false
cursor-text = 000000
shell-integration-features = no-cursor

bell-features = attention,no-system,no-title,no-border
notify-on-command-finish = unfocused

font-size = 16

macos-option-as-alt = true
macos-window-shadow = false
quit-after-last-window-closed = true
mouse-hide-while-typing = true

keybind = alt+shift+v=new_split:right
keybind = alt+shift+s=new_split:down
keybind = alt+shift+x=close_surface
keybind = alt+shift+h=goto_split:left
keybind = alt+shift+l=goto_split:right
keybind = alt+shift+j=goto_split:down
keybind = alt+shift+k=goto_split:up

keybind = alt+shift+c=new_tab
keybind = alt+shift+r=prompt_tab_title
keybind = alt+shift+q=close_tab

keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=goto_tab:9

keybind = alt+shift+p=toggle_command_palette
