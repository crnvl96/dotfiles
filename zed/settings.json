// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
//
// Keep this file project-agnostic. Anything that exists because of one
// repository's layout or tooling belongs in that repo's .zed/settings.json,
// which Zed merges on top of this file.
{
  "diff_view_style": "unified",
  "disable_ai": false,
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
      },
      "type": "registry",
    },
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "scroll_beyond_last_line": "one_page",
  "vertical_scroll_margin": 8,
  "gutter": {
    "line_numbers": true,
  },
  "command_aliases": {
    "W": "w",
    "Wq": "wq",
    "Q": "q",
  },
  "agent": {
    "favorite_models": [],
    "model_parameters": [],
    "terminal_init_command": "claude",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "base_keymap": "VSCode",
  "cursor_blink": false,
  "ui_font_size": 16,
  "agent_ui_font_size": 16,
  "buffer_font_size": 14,
  "agent_buffer_font_size": 14,
  "markdown_preview_font_size": 14,
  "git_commit_buffer_font_size": 14,
  "ui_font_family": "Monaco",
  "buffer_font_family": "Monaco",
  "agent_ui_font_family": "Monaco",
  "agent_buffer_font_family": "Monaco",
  "markdown_preview_font_family": "Monaco",
  "markdown_preview_code_font_family": "Monaco",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Gruvbox Dark Hard",
  },
  "code_lens": "on",
  "languages": {
    "TypeScript": {
      "inlay_hints": {
        "enabled": true,
      },
    },
    "TSX": {
      "inlay_hints": {
        "enabled": true,
      },
    },
    "JSON": {
      "format_on_save": "on",
    },
    "JSONC": {
      "format_on_save": "on",
    },
    "Go": {
      "inlay_hints": {
        "enabled": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
        "show_value_hints": true,
        "show_other_hints": true,
      },
    },
  },
  "lsp": {
    "gopls": {
      "initialization_options": {
        "codelenses": {
          "generate": true,
          "regenerate_cgo": true,
          "test": true,
          "tidy": true,
          "upgrade_dependency": true,
          "vendor": true,
        },
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "compositeLiteralTypes": true,
          "constantValues": true,
          "functionTypeParameters": true,
          "parameterNames": true,
          "rangeVariableTypes": true,
        },
      },
    },
  },
}
