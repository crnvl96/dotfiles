// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "use_key_equivalents": true,
    "bindings": {
      "cmd-g": "git_panel::ToggleFocus",
      "cmd-e": "project_panel::ToggleFocus",
      "cmd-t": "workspace::NewTerminal",
      "cmd-shift-w": "git::Worktree",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore",
    },
  },
  {
    "context": "Terminal",
    "use_key_equivalents": true,
    "bindings": {
      "cmd-1": ["pane::ActivateItem", 0],
      "cmd-2": ["pane::ActivateItem", 1],
      "cmd-3": ["pane::ActivateItem", 2],
      "cmd-4": ["pane::ActivateItem", 3],
      "cmd-5": [
        "pane::ActivateItem",
        4
      ],
      "shift-enter": [
        "terminal::SendText",
        "\u001b\r"
      ],
    },
  },
  {
    "context": "Editor && mode == full",
    "use_key_equivalents": true,
    "bindings": {
      "cmd-1": ["pane::ActivateItem", 0],
      "cmd-2": ["pane::ActivateItem", 1],
      "cmd-3": ["pane::ActivateItem", 2],
      "cmd-4": ["pane::ActivateItem", 3],
      "cmd-5": ["pane::ActivateItem", 4],
    },
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "cmd-e": "buffer_search::UseSelectionForFind",
    },
  },
  {
    "context": "KeymapEditor",
    "unbind": {
      "cmd-e": "zed::OpenKeymapFile",
    },
  },
  {
    "context": "GitPanel",
    "unbind": {
      "cmd-1": "git_panel::ActivateChangesTab",
    },
  },
  {
    "context": "GitPicker",
    "unbind": {
      "cmd-1": "git_picker::ActivateBranchesTab",
    },
  },
  {
    "context": "ImageViewer",
    "unbind": {
      "cmd-1": "image_viewer::ZoomToActualSize",
    },
  },
  {
    "context": "RunModal",
    "unbind": {
      "cmd-1": "new_process_modal::ActivateTaskTab",
    },
  },
  {
    "context": "Welcome",
    "unbind": {
      "cmd-1": ["welcome::OpenRecentProject", 0],
    },
  },
  {
    "context": "GitPanel",
    "unbind": {
      "cmd-2": "git_panel::ActivateHistoryTab",
    },
  },
  {
    "context": "GitPicker",
    "unbind": {
      "cmd-2": "git_picker::ActivateStashTab",
    },
  },
  {
    "context": "RunModal",
    "unbind": {
      "cmd-2": "new_process_modal::ActivateDebugTab",
    },
  },
  {
    "context": "Welcome",
    "unbind": {
      "cmd-2": ["welcome::OpenRecentProject", 1],
    },
  },
  {
    "context": "DebugPanel",
    "unbind": {
      "cmd-t": "debugger::ToggleThreadPicker",
    },
  },
  {
    "context": "KeymapEditor",
    "unbind": {
      "cmd-t": "keymap_editor::ShowMatchingKeybinds",
    },
  },
  {
    "context": "AcpThread",
    "unbind": {
      "cmd-g": "agent::SelectNextThreadMatch",
    },
  },
  {
    "context": "ThreadsSidebar",
    "unbind": {
      "cmd-g": "agents_sidebar::ToggleThreadHistory",
    },
  },
  {
    "context": "Pane",
    "unbind": {
      "cmd-g": "search::SelectNextMatch",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-1": ["workspace::ActivatePane", 0],
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-2": ["workspace::ActivatePane", 1],
    },
  },
  {
    "context": "RunModal",
    "unbind": {
      "cmd-3": "new_process_modal::ActivateAttachTab",
    },
  },
  {
    "context": "Welcome",
    "unbind": {
      "cmd-3": ["welcome::OpenRecentProject", 2],
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-3": ["workspace::ActivatePane", 2],
    },
  },
  {
    "context": "RunModal",
    "unbind": {
      "cmd-4": "new_process_modal::ActivateLaunchTab",
    },
  },
  {
    "context": "Welcome",
    "unbind": {
      "cmd-4": ["welcome::OpenRecentProject", 3],
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-4": ["workspace::ActivatePane", 3],
    },
  },
  {
    "context": "Welcome",
    "unbind": {
      "cmd-5": ["welcome::OpenRecentProject", 4],
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-5": ["workspace::ActivatePane", 4],
    },
  },
  {
    "unbind": {
      "cmd-shift-w": "workspace::CloseWindow"
    }
  }
]
